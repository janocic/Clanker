<!doctype html>
<html lang="hr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Clanker</title>
  </head>
  <body>
    <canvas id="matrix-bg" aria-hidden="true"></canvas>

    <div class="app-shell">
      <aside class="sidebar">
        <div class="brand">CLANKER<span class="cursor">_</span></div>

        <nav class="nav">
          <button class="nav-item active" data-view="overview">[ PREGLED ]</button>
          <div class="nav-label">// UREDAJI</div>
          <div id="device-nav"><span class="nav-empty">nema uredaja</span></div>
        </nav>

        <div class="sidebar-status">
          <span class="brand-dot" id="live-dot"></span>
          <span id="clock">--:--:--</span>
        </div>
      </aside>

      <div class="content">
        <header class="topbar">
          <div class="breadcrumb" id="breadcrumb">PREGLED</div>
        </header>

        <main id="view-overview">
          <section class="stats">
            <div class="term card">
              <div class="card-label">Uredaji</div>
              <div class="card-value" id="stat-devices">0</div>
            </div>
            <div class="term card">
              <div class="card-label">Upiti ukupno</div>
              <div class="card-value" id="stat-total">0</div>
            </div>
            <div class="term card card-danger">
              <div class="card-label">Blokirano upita</div>
              <div class="card-value" id="stat-blocked">0</div>
            </div>
            <div class="term card card-warn">
              <div class="card-label">Sumnjivih uredaja</div>
              <div class="card-value" id="stat-suspicious">0</div>
            </div>
            <div class="term card card-warn">
              <div class="card-label">Odspojeno uredaja</div>
              <div class="card-value" id="stat-cut">0</div>
            </div>
          </section>

          <section class="charts-row">
            <div class="term panel chart-panel">
              <div class="panel-head">
                <h2>[ BLOKIRANO PO UREDAJU ]</h2>
              </div>
              <div class="chart-body" id="bar-chart"></div>
            </div>
            <div class="term panel chart-panel">
              <div class="panel-head">
                <h2>[ UKUPNI PROMET ]</h2>
                <span class="panel-hint">svi uredaji, zadnjih ~60s</span>
              </div>
              <div class="chart-body" id="area-chart"></div>
            </div>
          </section>

          <section class="term panel">
            <div class="panel-head">
              <h2>[ LIVE BLOCKLIST ]</h2>
              <span class="panel-hint">dodaj domenu odmah, bez restarta</span>
            </div>
            <div class="blocklist-form">
              <input
                type="text"
                id="domain-input"
                placeholder="npr. neka-nova-ai-stranica.com"
                autocomplete="off"
                spellcheck="false"
              />
              <button class="btn btn-accent" id="ban-btn">BANNAJ</button>
            </div>
            <div class="chip-row" id="live-chips">
              <span class="chip-empty">Ucitavam...</span>
            </div>
          </section>

          <section class="term panel">
            <div class="panel-head">
              <h2>[ UREDAJI ]</h2>
              <span class="panel-hint">klikni IP za detalje &middot; osvjezava se svakih 1.5s</span>
            </div>
            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th>IP</th>
                    <th>MAC</th>
                    <th>Promet</th>
                    <th>Upiti</th>
                    <th>Blokirano</th>
                    <th>Status</th>
                    <th></th>
                  </tr>
                </thead>
                <tbody id="devices-body">
                  <tr class="empty-row"><td colspan="7">Cekam uredaje...</td></tr>
                </tbody>
              </table>
            </div>
          </section>

          <section class="term panel">
            <div class="panel-head">
              <h2>[ ZADNJI DNS UPITI ]</h2>
              <span class="panel-hint">najnoviji na vrhu</span>
            </div>
            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th>Vrijeme</th>
                    <th>Klijent</th>
                    <th>Domena</th>
                    <th>Status</th>
                  </tr>
                </thead>
                <tbody id="queries-body">
                  <tr class="empty-row"><td colspan="4">Nema jos upita...</td></tr>
                </tbody>
              </table>
            </div>
          </section>
        </main>

        <main id="view-device" hidden>
          <div class="device-header">
            <div>
              <h2 id="device-title">--</h2>
              <div class="mono-dim" id="device-mac">--</div>
            </div>
            <div class="device-header-right">
              <div id="device-badges"></div>
              <button class="btn" id="device-action-btn" data-action="toggle-block">--</button>
            </div>
          </div>

          <section class="stats stats-compact">
            <div class="term card">
              <div class="card-label">Upiti</div>
              <div class="card-value" id="device-stat-total">0</div>
            </div>
            <div class="term card card-danger">
              <div class="card-label">Blokirano</div>
              <div class="card-value" id="device-stat-blocked">0</div>
            </div>
            <div class="term card">
              <div class="card-label">Trenutni promet</div>
              <div class="card-value" id="device-stat-rate">0 B/s</div>
            </div>
          </section>

          <section class="term panel chart-panel">
            <div class="panel-head">
              <h2>[ PROMET UZIVO ]</h2>
              <span class="panel-hint">zadnjih ~60s</span>
            </div>
            <div class="chart-body" id="device-chart"></div>
          </section>

          <section class="term panel">
            <div class="panel-head">
              <h2>[ DNS UPITI OVOG UREDAJA ]</h2>
            </div>
            <div class="table-wrap">
              <table>
                <thead>
                  <tr>
                    <th>Vrijeme</th>
                    <th>Domena</th>
                    <th>Status</th>
                  </tr>
                </thead>
                <tbody id="device-queries-body">
                  <tr class="empty-row"><td colspan="3">Nema jos upita...</td></tr>
                </tbody>
              </table>
            </div>
          </section>
        </main>
      </div>
    </div>

    <footer>
      DNS blokada preko WinDivert-a &middot; odspajanje = Windows Firewall &middot;
      promet/sumnjivo = heuristika, ne dokaz
    </footer>

    <div id="toast" class="term toast" role="alert" hidden></div>

    <script>
      // ---------- element refs ----------
      const devicesBody = document.getElementById("devices-body")!;
      const queriesBody = document.getElementById("queries-body")!;
      const deviceQueriesBody = document.getElementById("device-queries-body")!;
      const clockEl = document.getElementById("clock")!;
      const liveDot = document.getElementById("live-dot")!;

      const statDevices = document.getElementById("stat-devices")!;
      const statTotal = document.getElementById("stat-total")!;
      const statBlocked = document.getElementById("stat-blocked")!;
      const statSuspicious = document.getElementById("stat-suspicious")!;
      const statCut = document.getElementById("stat-cut")!;

      const barChartEl = document.getElementById("bar-chart")!;
      const areaChartEl = document.getElementById("area-chart")!;
      const deviceChartEl = document.getElementById("device-chart")!;

      const deviceNavEl = document.getElementById("device-nav")!;
      const viewOverview = document.getElementById("view-overview")!;
      const viewDevice = document.getElementById("view-device")!;
      const breadcrumb = document.getElementById("breadcrumb")!;

      const deviceTitle = document.getElementById("device-title")!;
      const deviceMac = document.getElementById("device-mac")!;
      const deviceBadges = document.getElementById("device-badges")!;
      const deviceActionBtn = document.getElementById("device-action-btn") as HTMLButtonElement;
      const deviceStatTotal = document.getElementById("device-stat-total")!;
      const deviceStatBlocked = document.getElementById("device-stat-blocked")!;
      const deviceStatRate = document.getElementById("device-stat-rate")!;

      const domainInput = document.getElementById("domain-input") as HTMLInputElement;
      const banBtn = document.getElementById("ban-btn") as HTMLButtonElement;
      const liveChips = document.getElementById("live-chips")!;

      const toast = document.getElementById("toast")!;
      let toastTimer: ReturnType<typeof setTimeout> | undefined;

      // ---------- types ----------
      interface Device {
        ip: string;
        mac: string;
        total: number;
        blockedQueries: number;
        networkBlocked: boolean;
        traffic: number[];
        bandwidthBps: number;
        suspicious: boolean;
      }

      interface QueryEntry {
        ts: number;
        client_ip: string;
        client_mac: string;
        qname: string;
        blocked: boolean;
        reason: string;
        severity: "evasion" | "confirmed" | "suspected" | "clean";
      }

      let lastDevices: Device[] = [];
      let lastQueries: QueryEntry[] = [];
      let selectedIp: string | null = null;

      // ---------- helpers ----------
      function showToast(message: string, isError: boolean) {
        toast.textContent = message;
        toast.className = isError ? "term toast toast-error show" : "term toast toast-ok show";
        toast.hidden = false;
        clearTimeout(toastTimer);
        toastTimer = setTimeout(() => {
          toast.hidden = true;
        }, 3500);
      }

      function fmtTime(ts: number): string {
        return new Date(ts * 1000).toLocaleTimeString("hr-HR", { hour12: false });
      }

      function fmtRate(bps: number): string {
        if (bps > 1024 * 1024) return (bps / 1024 / 1024).toFixed(2) + " MB/s";
        if (bps > 1024) return (bps / 1024).toFixed(1) + " KB/s";
        return Math.round(bps) + " B/s";
      }

      // ---------- charts (hand-rolled SVG, no dependency) ----------
      function makeBarChart(labels: string[], values: number[], color: string): string {
        const width = 480;
        const height = 220;
        const padding = 32;
        const max = Math.max(...values, 1);
        const gap = (width - padding * 2) / Math.max(values.length, 1);
        const barWidth = Math.min(gap * 0.55, 46);

        let grid = "";
        for (let g = 0; g <= 4; g++) {
          const gy = padding + ((height - padding * 2) / 4) * g;
          grid += `<line x1="${padding}" y1="${gy.toFixed(1)}" x2="${width - padding}" y2="${gy.toFixed(1)}" class="chart-grid" />`;
        }

        let bars = "";
        values.forEach((v, i) => {
          const barHeight = (v / max) * (height - padding * 2);
          const x = padding + i * gap + (gap - barWidth) / 2;
          const y = height - padding - barHeight;
          bars += `<rect x="${x.toFixed(1)}" y="${y.toFixed(1)}" width="${barWidth.toFixed(1)}" height="${barHeight.toFixed(1)}" fill="${color}" />`;
          bars += `<text x="${(x + barWidth / 2).toFixed(1)}" y="${height - padding + 16}" text-anchor="middle" class="chart-label">${labels[i]}</text>`;
          if (v > 0) {
            bars += `<text x="${(x + barWidth / 2).toFixed(1)}" y="${(y - 6).toFixed(1)}" text-anchor="middle" class="chart-value">${v}</text>`;
          }
        });

        return `<svg viewBox="0 0 ${width} ${height}" class="chart-svg" preserveAspectRatio="xMidYMid meet">${grid}${bars}</svg>`;
      }

      function makeAreaChart(values: number[], color: string, fmt: (v: number) => string): string {
        const width = 480;
        const height = 220;
        const padding = 32;
        if (values.length < 2 || values.every((v) => v === 0)) {
          return `<div class="chart-empty">Nema jos podataka</div>`;
        }
        const max = Math.max(...values, 1);
        const stepX = (width - padding * 2) / (values.length - 1);
        const points = values.map((v, i) => {
          const x = padding + i * stepX;
          const y = height - padding - (v / max) * (height - padding * 2);
          return [x, y];
        });
        const linePath = points.map((p, i) => `${i === 0 ? "M" : "L"} ${p[0].toFixed(1)} ${p[1].toFixed(1)}`).join(" ");
        const last = points[points.length - 1];
        const first = points[0];
        const areaPath = `${linePath} L ${last[0].toFixed(1)} ${height - padding} L ${first[0].toFixed(1)} ${height - padding} Z`;

        let grid = "";
        for (let g = 0; g <= 4; g++) {
          const gy = padding + ((height - padding * 2) / 4) * g;
          grid += `<line x1="${padding}" y1="${gy.toFixed(1)}" x2="${width - padding}" y2="${gy.toFixed(1)}" class="chart-grid" />`;
        }

        return `<svg viewBox="0 0 ${width} ${height}" class="chart-svg" preserveAspectRatio="xMidYMid meet">
          ${grid}
          <path d="${areaPath}" fill="${color}" opacity="0.18" />
          <path d="${linePath}" fill="none" stroke="${color}" stroke-width="2.2" />
          <text x="${padding}" y="18" class="chart-value">max ${fmt(max)}</text>
        </svg>`;
      }

      function renderSparkline(values: number[], suspicious: boolean): string {
        const w = 90;
        const h = 26;
        if (values.length < 2 || values.every((v) => v === 0)) {
          return `<span class="mono-dim">--</span>`;
        }
        const max = Math.max(...values, 1);
        const step = w / Math.max(values.length - 1, 1);
        const path = values
          .map((v, i) => `${i === 0 ? "M" : "L"} ${(i * step).toFixed(1)} ${(h - (v / max) * h).toFixed(1)}`)
          .join(" ");
        const stroke = suspicious ? "var(--warn)" : "var(--accent)";
        return `<svg class="spark" viewBox="0 0 ${w} ${h}" preserveAspectRatio="none">
          <path d="${path}" fill="none" stroke="${stroke}" stroke-width="1.6" stroke-linejoin="round" stroke-linecap="round" />
        </svg>`;
      }

      function aggregateTraffic(devices: Device[]): number[] {
        const maxLen = Math.max(0, ...devices.map((d) => d.traffic.length));
        const result = new Array(maxLen).fill(0);
        for (const d of devices) {
          const offset = maxLen - d.traffic.length;
          d.traffic.forEach((v, i) => {
            result[offset + i] += v;
          });
        }
        return result;
      }

      // ---------- rendering: overview ----------
      function renderBarChartPanel(devices: Device[]) {
        const sorted = [...devices].sort((a, b) => b.blockedQueries - a.blockedQueries);
        const shown = sorted.slice(0, 12);
        if (shown.length === 0 || shown.every((d) => d.blockedQueries === 0)) {
          barChartEl.innerHTML = `<div class="chart-empty">Nema blokiranih upita jos</div>`;
          return;
        }
        const labels = shown.map((d) => "." + d.ip.split(".").slice(-1)[0]);
        const values = shown.map((d) => d.blockedQueries);
        let html = makeBarChart(labels, values, "var(--danger)");
        if (sorted.length > shown.length) {
          html += `<div class="chart-note">prikazano ${shown.length} od ${sorted.length} (najvise blokiranih)</div>`;
        }
        barChartEl.innerHTML = html;
      }

      function renderAreaChartPanel(devices: Device[]) {
        areaChartEl.innerHTML = makeAreaChart(aggregateTraffic(devices), "var(--accent)", fmtRate);
      }

      function renderDeviceNav(devices: Device[]) {
        if (devices.length === 0) {
          deviceNavEl.innerHTML = `<span class="nav-empty">nema uredaja</span>`;
          return;
        }
        deviceNavEl.innerHTML = devices
          .map((d) => {
            let dot = "dot-ok";
            if (d.networkBlocked) dot = "dot-danger";
            else if (d.suspicious) dot = "dot-warn";
            const active = d.ip === selectedIp ? "active" : "";
            return `<button class="nav-item device-nav-item ${active}" data-ip="${d.ip}">
              <span class="nav-dot ${dot}"></span>${d.ip}
            </button>`;
          })
          .join("");
      }

      function renderDevicesTable(devices: Device[]) {
        if (devices.length === 0) {
          devicesBody.innerHTML = `<tr class="empty-row"><td colspan="7">Nema spojenih uredaja</td></tr>`;
          return;
        }
        devicesBody.innerHTML = devices
          .map((d) => {
            const rowClass = [d.blockedQueries > 0 ? "flagged" : "", d.suspicious ? "suspicious-row" : ""]
              .join(" ")
              .trim();
            const accessLabel = d.networkBlocked
              ? `<span class="badge badge-danger">ODSPOJEN</span>`
              : `<span class="badge badge-ok">OK</span>`;
            const suspiciousLabel = d.suspicious
              ? `<span class="badge badge-warn" title="Neuobicajeno velik promet - moze biti i streaming/download, provjeri rucno">SUMNJIVO</span>`
              : "";
            const btnLabel = d.networkBlocked ? "VRATI PRISTUP" : "ODSPOJI";
            const btnClass = d.networkBlocked ? "btn btn-ghost" : "btn btn-danger";
            return `
              <tr class="${rowClass}">
                <td><button class="device-ip-link" data-ip="${d.ip}">${d.ip}</button></td>
                <td class="mono-dim">${d.mac}</td>
                <td>
                  ${renderSparkline(d.traffic, d.suspicious)}
                  <div class="rate-label">${fmtRate(d.bandwidthBps)}</div>
                </td>
                <td>${d.total}</td>
                <td>${d.blockedQueries}</td>
                <td>${accessLabel} ${suspiciousLabel}</td>
                <td>
                  <button class="${btnClass}" data-action="toggle-block" data-ip="${d.ip}" data-blocked="${d.networkBlocked}">
                    ${btnLabel}
                  </button>
                </td>
              </tr>`;
          })
          .join("");
      }

      function severityDomainHtml(q: QueryEntry): { domainHtml: string; status: string } {
        if (q.blocked && q.severity === "evasion") {
          return {
            domainHtml: `<span class="domain-evasion">${q.qname}<span class="mark">!!</span></span>`,
            status: `<span class="badge badge-evasion">DoH ZAOBILAZI</span>`,
          };
        }
        if (q.blocked && q.severity === "confirmed") {
          return {
            domainHtml: `<span class="domain-danger">${q.qname}<span class="mark">!</span></span>`,
            status: `<span class="badge badge-danger">AI !</span>`,
          };
        }
        if (q.blocked && q.severity === "suspected") {
          return {
            domainHtml: `<span class="domain-warn">${q.qname}</span>`,
            status: `<span class="badge badge-warn">AI ?</span>`,
          };
        }
        return { domainHtml: q.qname, status: `<span class="badge badge-ok">ok</span>` };
      }

      function renderQueriesTable(tbody: HTMLElement, queries: QueryEntry[], opts: { filterIp?: string; showClient: boolean }) {
        const rows = opts.filterIp ? queries.filter((q) => q.client_ip === opts.filterIp) : queries;
        const colspan = opts.showClient ? 4 : 3;
        if (rows.length === 0) {
          tbody.innerHTML = `<tr class="empty-row"><td colspan="${colspan}">Nema jos upita...</td></tr>`;
          return;
        }
        tbody.innerHTML = rows
          .slice(0, 30)
          .map((q) => {
            const { domainHtml, status } = severityDomainHtml(q);
            const clientCell = opts.showClient ? `<td>${q.client_ip}</td>` : "";
            return `
              <tr>
                <td class="mono-dim">${fmtTime(q.ts)}</td>
                ${clientCell}
                <td>${domainHtml}</td>
                <td>${status}</td>
              </tr>`;
          })
          .join("");
      }

      function renderOverview() {
        const devices = lastDevices;
        statDevices.textContent = String(devices.length);
        statTotal.textContent = String(devices.reduce((a, d) => a + d.total, 0));
        statBlocked.textContent = String(devices.reduce((a, d) => a + d.blockedQueries, 0));
        statSuspicious.textContent = String(devices.filter((d) => d.suspicious).length);
        statCut.textContent = String(devices.filter((d) => d.networkBlocked).length);

        renderBarChartPanel(devices);
        renderAreaChartPanel(devices);
        renderDevicesTable(devices);
        renderQueriesTable(queriesBody, lastQueries, { showClient: true });
      }

      // ---------- rendering: device detail ----------
      function renderDeviceView() {
        const device = lastDevices.find((d) => d.ip === selectedIp);
        if (!device) {
          showOverview();
          return;
        }

        deviceTitle.textContent = device.ip;
        deviceMac.textContent = device.mac;

        const badges = [
          device.networkBlocked
            ? `<span class="badge badge-danger">ODSPOJEN</span>`
            : `<span class="badge badge-ok">ONLINE</span>`,
        ];
        if (device.suspicious) {
          badges.push(
            `<span class="badge badge-warn" title="Neuobicajeno velik promet - provjeri rucno">SUMNJIVO</span>`,
          );
        }
        deviceBadges.innerHTML = badges.join(" ");

        deviceStatTotal.textContent = String(device.total);
        deviceStatBlocked.textContent = String(device.blockedQueries);
        deviceStatRate.textContent = fmtRate(device.bandwidthBps);

        deviceChartEl.innerHTML = makeAreaChart(
          device.traffic,
          device.suspicious ? "var(--warn)" : "var(--accent)",
          fmtRate,
        );

        const btnLabel = device.networkBlocked ? "VRATI PRISTUP" : "ODSPOJI";
        deviceActionBtn.className = device.networkBlocked ? "btn btn-ghost" : "btn btn-danger";
        deviceActionBtn.textContent = btnLabel;
        deviceActionBtn.dataset.ip = device.ip;
        deviceActionBtn.dataset.blocked = String(device.networkBlocked);

        renderQueriesTable(deviceQueriesBody, lastQueries, { filterIp: device.ip, showClient: false });
      }

      function renderAll() {
        renderDeviceNav(lastDevices);
        if (selectedIp) {
          renderDeviceView();
        } else {
          renderOverview();
        }
      }

      // ---------- view switching ----------
      function showOverview() {
        selectedIp = null;
        viewOverview.hidden = false;
        viewDevice.hidden = true;
        document.querySelector('[data-view="overview"]')?.classList.add("active");
        breadcrumb.textContent = "PREGLED";
        renderAll();
      }

      function showDevice(ip: string) {
        selectedIp = ip;
        viewOverview.hidden = true;
        viewDevice.hidden = false;
        document.querySelector('[data-view="overview"]')?.classList.remove("active");
        breadcrumb.textContent = `UREDAJ / ${ip}`;
        renderAll();
      }

      // ---------- data polling ----------
      async function refresh() {
        try {
          const [devicesRes, queriesRes] = await Promise.all([fetch("/api/devices"), fetch("/api/queries")]);
          lastDevices = await devicesRes.json();
          lastQueries = await queriesRes.json();
          renderAll();
          liveDot.classList.remove("dot-error");
        } catch {
          liveDot.classList.add("dot-error");
        }
      }

      // ---------- blocklist manager ----------
      function renderChips(live: string[]) {
        if (live.length === 0) {
          liveChips.innerHTML = `<span class="chip-empty">Nema jos dodanih domena</span>`;
          return;
        }
        liveChips.innerHTML = live
          .map(
            (d) => `
              <span class="chip">
                ${d}
                <button class="chip-remove" data-domain="${d}" title="Ukloni">&times;</button>
              </span>`,
          )
          .join("");
      }

      async function refreshBlocklist() {
        try {
          const res = await fetch("/api/blocklist");
          const data = await res.json();
          renderChips(data.live || []);
        } catch {
          // silent - next poll retries
        }
      }

      async function banDomain() {
        const domain = domainInput.value.trim();
        if (!domain) return;
        banBtn.disabled = true;
        try {
          const res = await fetch("/api/blocklist", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ domain }),
          });
          const body = await res.json().catch(() => ({}));
          if (!res.ok) {
            showToast(body.error || "Neispravna domena.", true);
          } else {
            showToast(`${body.domain} - banovan`, false);
            domainInput.value = "";
          }
        } catch {
          showToast("Server ne odgovara.", true);
        } finally {
          banBtn.disabled = false;
          refreshBlocklist();
        }
      }

      banBtn.addEventListener("click", banDomain);
      domainInput.addEventListener("keydown", (event) => {
        if (event.key === "Enter") banDomain();
      });

      // ---------- delegated click handling (content is rebuilt often) ----------
      async function setBlocked(ip: string, block: boolean): Promise<boolean> {
        const endpoint = block ? "/api/block" : "/api/unblock";
        try {
          const res = await fetch(endpoint, {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ ip }),
          });
          const body = await res.json().catch(() => ({}));
          if (!res.ok) {
            showToast(body.error || "Akcija nije uspjela.", true);
            return false;
          }
          showToast(block ? `${ip} - odspojen` : `${ip} - pristup vracen`, false);
          return true;
        } catch {
          showToast("Server ne odgovara.", true);
          return false;
        }
      }

      document.body.addEventListener("click", async (event) => {
        const target = event.target as HTMLElement;

        const overviewNav = target.closest('[data-view="overview"]');
        if (overviewNav) {
          showOverview();
          return;
        }

        const deviceNavBtn = target.closest(".device-nav-item[data-ip]") as HTMLButtonElement | null;
        if (deviceNavBtn) {
          showDevice(deviceNavBtn.dataset.ip!);
          return;
        }

        const ipLink = target.closest(".device-ip-link[data-ip]") as HTMLButtonElement | null;
        if (ipLink) {
          showDevice(ipLink.dataset.ip!);
          return;
        }

        const blockBtn = target.closest("button[data-action='toggle-block']") as HTMLButtonElement | null;
        if (blockBtn) {
          const ip = blockBtn.dataset.ip!;
          const currentlyBlocked = blockBtn.dataset.blocked === "true";
          blockBtn.disabled = true;
          const ok = await setBlocked(ip, !currentlyBlocked);
          blockBtn.disabled = false;
          if (ok) refresh();
          return;
        }

        const chipRemoveBtn = target.closest("button[data-domain]") as HTMLButtonElement | null;
        if (chipRemoveBtn) {
          const domain = chipRemoveBtn.dataset.domain!;
          chipRemoveBtn.disabled = true;
          await fetch("/api/blocklist", {
            method: "DELETE",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ domain }),
          });
          showToast(`${domain} - uklonjen s live liste`, false);
          refreshBlocklist();
        }
      });

      // ---------- clock ----------
      function tickClock() {
        clockEl.textContent = new Date().toLocaleTimeString("hr-HR", { hour12: false });
      }
      tickClock();
      setInterval(tickClock, 1000);

      // ---------- matrix rain background ----------
      (function initMatrixRain() {
        const canvas = document.getElementById("matrix-bg") as HTMLCanvasElement;
        const ctx = canvas.getContext("2d");
        if (!ctx) return;

        const fontSize = 15;
        const chars = "01アイウエオカキクケコABCDEFGHIJKLMNOPQRSTUVWXYZ$#@!<>[]";
        let columns = 0;
        let drops: number[] = [];

        function resize() {
          canvas.width = window.innerWidth;
          canvas.height = window.innerHeight;
          columns = Math.floor(canvas.width / fontSize);
          drops = new Array(columns).fill(0).map(() => Math.floor(Math.random() * -40));
        }
        window.addEventListener("resize", resize);
        resize();

        function frame() {
          if (!ctx) return;
          ctx.fillStyle = "rgba(0, 0, 0, 0.10)";
          ctx.fillRect(0, 0, canvas.width, canvas.height);
          ctx.fillStyle = "#1f9d3a";
          ctx.font = fontSize + "px monospace";
          for (let i = 0; i < drops.length; i++) {
            const char = chars[Math.floor(Math.random() * chars.length)];
            ctx.fillText(char, i * fontSize, drops[i] * fontSize);
            if (drops[i] * fontSize > canvas.height && Math.random() > 0.975) {
              drops[i] = 0;
            }
            drops[i]++;
          }
        }
        setInterval(frame, 60);
      })();

      // ---------- boot ----------
      refresh();
      refreshBlocklist();
      setInterval(refresh, 1500);
      setInterval(refreshBlocklist, 5000);
    </script>

